# Copy to `.env.local` and fill in your own values.
# All variables must be prefixed with VITE_ so Vite exposes them to the bundle.

# --- Terrain elevation backend ---
# Chosen at runtime from the Settings panel: Microsoft Planetary Computer
# (Copernicus GLO-30, DSM ~30 m) or AWS Terrain Tiles (EU-DEM ~25 m DTM
# over Europe, 3DEP over USA, SRTM elsewhere). Both are public and key-less.

# --- OpenAIP (optional, reserved for future REST-API use) ---
# VITE_OPENAIP_API_KEY=your-openaip-key-here

# --- Umami analytics (optional) ---
# Leave both empty (or unset) to disable analytics — the app makes no network
# call to Umami in that case. Anonymous, cookieless usage events only.
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id
